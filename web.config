<?xml version="1.0" encoding="UTF-8"?>
<!--
  Protección por si el sitio de IIS se apunta por error a la raíz del proyecto
  en lugar de a la carpeta public\. Lo correcto es apuntar a public\ (ver README.md).
-->
<configuration>
  <system.webServer>
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="app" />
          <add segment="database" />
          <add segment="herramientas" />
          <add segment="storage" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".sql" allowed="false" />
          <add fileExtension=".md" allowed="false" />
          <add fileExtension=".csv" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
